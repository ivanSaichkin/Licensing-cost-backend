            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "licensings"
                ],
                "summary": "Лента",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID",
                        "name": "id",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Следующая",
                        "name": "next",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.LicensingFeedSerializer"
                        }
                    },
                    "404": {
                        "description": "Not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/licensings": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "licensings"
                ],
                "summary": "Список моделей",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Макс. комиссия",
                        "name": "max_commission",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ds.LicensingListSerializer"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "licensings"
                ],
                "summary": "Создать черновик",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название",
                        "name": "title",
                        "in": "formData",
