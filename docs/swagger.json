            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "licensings"
                ],
                "summary": "Лайк",
                "parameters": [
                    {
                        "type": "integer",
